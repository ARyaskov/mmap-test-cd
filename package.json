{
    "name": "@riaskov/mmap",
    "version": "2.0.28",
    "license": "MIT",
    "author": {
        "name": "Andrei Riaskov",
        "email": "code@riaskov.com"
    },
    "engines": {
        "node": "^18.17.0 || >=20.5.0"
    },
    "binary": {
        "module_name": "mmap_io",
        "module_path": "./build/binding/{configuration}/{node_abi}-{platform}-{arch}/",
        "remote_path": "./v{version}/",
        "package_name": "{module_name}-v{version}-{node_abi}-{platform}-{arch}.tar.gz",
        "host": "https://github.com/ARyaskov/mmap-test-cd/releases/download/"
    },
    "description": "Node.js mmap bindings",
    "homepage": "https://github.com/ARyaskov/mmap-test-cd/",
    "keywords": [
        "low level",
        "file",
        "memory mapped",
        "mmap",
        "advise",
        "sync",
        "shared memory",
        "C++",
        "performance"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ARyaskov/mmap.git"
    },
    "main": "./src/index.js",
    "types": "./types/index.d.ts",
    "files": [
        "src",
        "types",
        "binding.gyp"
    ],
    "scripts": {
        "build": "npm run build:ts && npm run build:addon",
        "build:ts": "tsc",
        "build:addon": "node-pre-gyp rebuild",
        "build-es": "yarn tsc && cpx ./dist/mmap-io.d.ts ./",
        "build-addon": "yarn node-pre-gyp rebuild",
        "package-binary": "yarn node-pre-gyp package",
        "push-binary": "yarn node-pre-gyp-github publish",
        "postinstall": "npx node-pre-gyp install --fallback-to-build",
        "clean": "rimraf dist",
        "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" *.js *.d.ts",
        "test": "npm run build && mocha 'test/**/*.js'"
    },
    "dependencies": {
        "@mapbox/node-pre-gyp": "1.1.0-dev.1",
        "nan": "2.22.0",
        "run-script-os": "1.1.6"
    },
    "devDependencies": {
        "@riaskov/node-pre-gyp-github": "3.0.0",
        "@types/chai": "5.0.1",
        "@types/mocha": "10.0.10",
        "@types/node": "18.19.68",
        "chai": "4.5.0",
        "cpx": "1.5.0",
        "mocha": "10.8.2",
        "node-gyp": "11.0.0",
        "npx": "10.2.2",
        "prettier": "3.4.2",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "tsx": "4.19.2",
        "typescript": "5.7.2"
    }
}
